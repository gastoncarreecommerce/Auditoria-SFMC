# Copiá este archivo a .env.local para correr en local, o cargá las mismas
# variables en Vercel → Project Settings → Environment Variables.

# Credenciales del paquete instalado de SFMC (mismas que usa el resto del
# repo para la auditoría — Setup → Apps → tu Installed Package → API Integration).
SFMC_CLIENT_ID=
SFMC_CLIENT_SECRET=
SFMC_SUBDOMAIN=
SFMC_PARENT_ACCOUNT_ID=

# Contraseña de acceso a esta herramienta. Elegí una fuerte: quien la tenga
# puede vaciar Data Extensions de producción.
APP_PASSWORD=
